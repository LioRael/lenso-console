{
  "name": "@lenso/console-web",
  "version": "1.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --configLoader native",
    "bundle:local": "bun ../../../tooling/distribution/clean-console-web.mjs && VITE_CONSOLE_MODE=${VITE_CONSOLE_MODE:-api} VITE_API_BASE_URL=${VITE_API_BASE_URL:-/} bun --bun vite build --configLoader native",
    "test:local": "bun test --preload ./test/stylex-preload.ts ./src",
    "test:browser": "bun test ./test/browser",
    "typecheck:local": "bun --bun tsc -b --pretty false",
    "preview": "bun --bun vite preview --configLoader native --host 0.0.0.0",
    "build": "bun run typecheck:local && bun run bundle:local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@lenso/console-sdk": "workspace:*",
    "@lenso/tokens": "0.9.1",
    "@lenso/ui": "0.9.1",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-start": "^1.168.38",
    "@vitejs/plugin-react": "^6.0.5",
    "ky": "^2.0.2",
    "lucide-react": "^1.28.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  }
}
