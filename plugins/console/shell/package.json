{
  "name": "@lenso/console-web",
  "version": "1.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_CONSOLE_DEV_MODE=${VITE_CONSOLE_DEV_MODE:-mock} VITE_CONSOLE_MODE=${VITE_CONSOLE_MODE:-mock} vite",
    "bundle:local": "node ../../../tooling/distribution/clean-console-web.mjs && VITE_CONSOLE_MODE=${VITE_CONSOLE_MODE:-api} VITE_API_BASE_URL=${VITE_API_BASE_URL:-/} vite build",
    "test:local": "vitest run src --exclude '**/*.browser.test.*'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck:local": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "build": "pnpm typecheck:local && pnpm bundle:local"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@lenso/console-sdk": "workspace:*",
    "@lenso/primitives": "0.7.0",
    "@lenso/tokens": "0.9.1",
    "@lenso/ui": "0.9.1",
    "@streamdown/cjk": "^1.0.3",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-start": "^1.168.38",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^6.0.5",
    "gsap": "^3.15.0",
    "ky": "^2.0.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smol-toml": "^1.8.0",
    "streamdown": "^2.6.0",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@lenso/contract-runtime": "0.3.1",
    "@orpc/server": "2.0.0-beta.42",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "agentation": "3.1.2",
    "playwright": "1.62.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.10",
    "typescript": "7.0.2",
    "use-sync-external-store": "1.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
