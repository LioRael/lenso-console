{
  "name": "@lenso/console-web",
  "version": "1.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_CONSOLE_DEV_MODE=${VITE_CONSOLE_DEV_MODE:-mock} VITE_CONSOLE_MODE=${VITE_CONSOLE_MODE:-mock} vite",
    "bundle:local": "node ../../../tooling/distribution/clean-console-web.mjs && VITE_CONSOLE_MODE=${VITE_CONSOLE_MODE:-api} VITE_API_BASE_URL=${VITE_API_BASE_URL:-/} vite build",
    "test:local": "vitest run src --exclude '**/*.browser.test.*'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck:local": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "build": "pnpm typecheck:local && pnpm bundle:local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@lenso/tokens": "0.9.1",
    "@lenso/ui": "0.9.1",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-start": "^1.168.38",
    "@vitejs/plugin-react": "^6.0.5",
    "ky": "^2.0.2",
    "lucide-react": "^1.28.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
