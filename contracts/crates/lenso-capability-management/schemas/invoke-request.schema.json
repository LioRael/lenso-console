{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["entry_id", "version", "input_json", "idempotency_key", "expected_revision"],
  "properties": {
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "input_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 262144
    },
    "idempotency_key": {
      "$ref": "#/$defs/Nullable_string"
    },
    "expected_revision": {
      "$ref": "#/$defs/Nullable_string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Nullable_string": {
      "type": ["string", "null"]
    }
  },
  "title": "InvokeRequest"
}
