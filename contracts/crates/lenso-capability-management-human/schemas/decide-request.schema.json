{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["operation_id", "intent_digest", "decision"],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intent_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Decision": {
      "type": "string",
      "enum": ["approved", "rejected"]
    }
  },
  "title": "DecideRequest"
}
