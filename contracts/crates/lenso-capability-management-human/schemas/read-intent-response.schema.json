{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "audit_pending",
    "operation_id",
    "requester",
    "deployment",
    "entry_id",
    "target_instance",
    "capability",
    "version",
    "operation",
    "description",
    "intent_digest",
    "expires_at",
    "parameters_json",
    "status"
  ],
  "properties": {
    "audit_pending": {
      "type": "boolean"
    },
    "operation_id": {
      "type": "string"
    },
    "requester": {
      "type": "string"
    },
    "deployment": {
      "type": "string"
    },
    "entry_id": {
      "type": "string"
    },
    "target_instance": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "intent_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "expires_at": {
      "type": "string"
    },
    "parameters_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 262144
    },
    "status": {
      "$ref": "#/$defs/IntentStatus"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "IntentStatus": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "cancelled", "expired"]
    }
  },
  "title": "ReadIntentResponse"
}
