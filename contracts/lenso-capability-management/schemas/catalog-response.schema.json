{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["deployment", "revision", "entries"],
  "properties": {
    "deployment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/Entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Effect": {
      "type": "string",
      "enum": ["read", "write"]
    },
    "Entry": {
      "type": "object",
      "required": [
        "id",
        "target_instance",
        "capability",
        "version",
        "operation",
        "input_schema_json",
        "description",
        "effect",
        "requires_approval"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_schema_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 65536
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "requires_approval": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "title": "CatalogResponse"
}
