{
  "name": "@lenso/console-package-api",
  "version": "0.1.3",
  "description": "Shared host contract for Lenso Console packages.",
  "keywords": [
    "console-package",
    "lenso",
    "lenso-console"
  ],
  "homepage": "https://github.com/LioRael/lenso-console#readme",
  "bugs": {
    "url": "https://github.com/LioRael/lenso-console/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-console.git",
    "directory": "packages/console-package-api"
  },
  "files": [
    "dist",
    "README.md",
    "components.css",
    "theme.css",
    "tokens.css"
  ],
  "type": "module",
  "sideEffects": [
    "./components.css",
    "./theme.css",
    "./tokens.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components.css": "./components.css",
    "./theme.css": "./theme.css",
    "./tokens.css": "./tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
