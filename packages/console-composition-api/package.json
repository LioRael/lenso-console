  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsdown --config tsdown.config.ts",
    "test": "vitest run src"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }
}
