{
  "name": "@lenso/console-composition-api",
  "version": "0.1.0",
  "description": "Versioned Host contract for Lenso Console UI Compositions.",
  "keywords": [
    "composition",
    "console",
    "lenso",
    "theme"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
