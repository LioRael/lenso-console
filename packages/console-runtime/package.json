{
  "name": "@lenso/console-runtime",
  "version": "0.1.0",
  "description": "Optional read-only Runtime Console inspection",
  "license": "MIT",
  "files": [
    "dist",
    "console/page.tsx",
    "console/workspace.ts",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun run --bun tsc --noEmit -p tsconfig.json",
    "test": "bun test test"
  },
  "dependencies": {
    "@lenso/ui": "0.9.1",
    "@stylexjs/stylex": "^0.19.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@lenso/console": "*",
    "@lenso/console-sdk": "*",
    "@lenso/core": "^0.3.1",
    "@lenso/engine": "^0.6.0",
    "@lenso/manage": "^0.5.2",
    "@lenso/runtime": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lenso/runtime": {
      "optional": true
    }
  }
}
