{
  "name": "@lenso/console-ui",
  "version": "0.2.0",
  "description": "React adapter for dynamically loaded Lenso Console Module UI.",
  "keywords": [
    "console",
    "lenso",
    "module",
    "react",
    "ui"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/assets/stylex.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/LioRael/lenso-console",
    "directory": "packages/console-ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stylex.css": "./dist/assets/stylex.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsdown --config tsdown.config.ts",
    "test": "vitest run --config ../../vite.config.ts src"
  },
  "dependencies": {
    "@lenso/console-module-api": "workspace:*",
    "@lenso/console-tokens": "workspace:*",
    "@stylexjs/stylex": "0.19.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }
}
