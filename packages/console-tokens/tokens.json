{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "reference": {
      "black": { "$type": "color", "$value": "#000000" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "neutral-100": { "$type": "color", "$value": "#f5f5f5" },
      "neutral-200": { "$type": "color", "$value": "#eaeaea" },
      "neutral-700": { "$type": "color", "$value": "#525252" },
      "neutral-800": { "$type": "color", "$value": "#333333" },
      "neutral-900": { "$type": "color", "$value": "#1f1f1f" }
    },
    "semantic": {
      "canvas": { "$type": "color", "$value": "{color.reference.black}" },
      "window": { "$type": "color", "$value": "{color.reference.black}" },
      "surface": { "$type": "color", "$value": "{color.reference.black}" },
      "surfaceRaised": { "$type": "color", "$value": "#0a0a0a" },
      "surfaceMuted": { "$type": "color", "$value": "#0a0a0a" },
      "panel": { "$type": "color", "$value": "{color.reference.black}" },
      "panelMuted": { "$type": "color", "$value": "#050505" },
      "panelHeader": { "$type": "color", "$value": "#0a0a0a" },
      "rowHover": { "$type": "color", "$value": "#111111" },
      "rowSelected": { "$type": "color", "$value": "#1f1f1f" },
      "control": { "$type": "color", "$value": "{color.reference.black}" },
      "controlHover": { "$type": "color", "$value": "#111111" },
      "controlActive": { "$type": "color", "$value": "#1a1a1a" },
      "overlay": { "$type": "color", "$value": "{color.reference.black}" },
      "sidebar": { "$type": "color", "$value": "#0a0a0a" },
      "foreground": { "$type": "color", "$value": "{color.reference.white}" },
      "foregroundSecondary": { "$type": "color", "$value": "#d4d4d4" },
      "foregroundTertiary": { "$type": "color", "$value": "#737373" },
      "foregroundQuaternary": { "$type": "color", "$value": "#525252" },
      "foregroundOnAccent": {
        "$type": "color",
        "$value": "{color.reference.black}"
      },
      "foregroundInverse": {
        "$type": "color",
        "$value": "{color.reference.black}"
      },
      "line": { "$type": "color", "$value": "{color.reference.neutral-800}" },
      "lineSubtle": {
        "$type": "color",
        "$value": "{color.reference.neutral-900}"
      },
      "lineStrong": { "$type": "color", "$value": "#444444" },
      "accent": { "$type": "color", "$value": "{color.reference.white}" },
      "accentHover": { "$type": "color", "$value": "{color.reference.white}" },
      "accentMuted": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.08)"
      },
      "accentForeground": {
        "$type": "color",
        "$value": "{color.reference.black}"
      },
      "success": { "$type": "color", "$value": "#00a63e" },
      "warning": { "$type": "color", "$value": "#f5a524" },
      "error": { "$type": "color", "$value": "#e5484d" },
      "info": { "$type": "color", "$value": "#0070f3" },
      "toneMutedBg": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.06)"
      },
      "toneMutedBorder": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.14)"
      },
      "toneMutedForeground": { "$type": "color", "$value": "#d4d4d4" },
      "toneInfoBg": { "$type": "color", "$value": "rgba(0, 112, 243, 0.12)" },
      "toneInfoBorder": {
        "$type": "color",
        "$value": "rgba(0, 112, 243, 0.3)"
      },
      "toneInfoForeground": { "$type": "color", "$value": "#d4d4d4" },
      "toneSuccessBg": { "$type": "color", "$value": "rgba(0, 166, 62, 0.12)" },
      "toneSuccessBorder": {
        "$type": "color",
        "$value": "rgba(0, 166, 62, 0.28)"
      },
      "toneSuccessForeground": { "$type": "color", "$value": "#00a63e" },
      "toneWarningBg": {
        "$type": "color",
        "$value": "rgba(245, 165, 36, 0.12)"
      },
      "toneWarningBorder": {
        "$type": "color",
        "$value": "rgba(245, 165, 36, 0.3)"
      },
      "toneWarningForeground": { "$type": "color", "$value": "#f5a524" },
      "toneErrorBg": { "$type": "color", "$value": "rgba(229, 72, 77, 0.13)" },
      "toneErrorBorder": {
        "$type": "color",
        "$value": "rgba(229, 72, 77, 0.32)"
      },
      "toneErrorForeground": { "$type": "color", "$value": "#ff8589" },
      "focusRing": { "$type": "color", "$value": "rgba(255, 255, 255, 0.72)" },
      "focusRingMuted": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.22)"
      }
    }
  },
  "dimension": {
    "radius": {
      "control": { "$type": "dimension", "$value": "6px" },
      "panel": { "$type": "dimension", "$value": "6px" },
      "popover": { "$type": "dimension", "$value": "8px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "control": {
      "heightSm": { "$type": "dimension", "$value": "28px" },
      "heightMd": { "$type": "dimension", "$value": "32px" },
      "heightLg": { "$type": "dimension", "$value": "36px" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "1-5": { "$type": "dimension", "$value": "6px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" }
    },
    "layout": {
      "contentGutter": { "$type": "dimension", "$value": "20px" },
      "contentMaxWidth": { "$type": "dimension", "$value": "1480px" },
      "pageGutter": { "$type": "dimension", "$value": "32px" },
      "pageMaxWidth": { "$type": "dimension", "$value": "1216px" },
      "sidebarWidth": { "$type": "dimension", "$value": "224px" },
      "sidebarCollapsedWidth": { "$type": "dimension", "$value": "64px" },
      "toolbarHeight": { "$type": "dimension", "$value": "48px" },
      "inspectorWidth": { "$type": "dimension", "$value": "376px" },
      "tableRowHeight": { "$type": "dimension", "$value": "64px" },
      "tableHeaderHeight": { "$type": "dimension", "$value": "38px" },
      "paneHeaderHeight": { "$type": "dimension", "$value": "50px" },
      "tabHeight": { "$type": "dimension", "$value": "33px" }
    }
  },
  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": ["IBM Plex Sans", "sans-serif"]
      },
      "code": { "$type": "fontFamily", "$value": ["Roboto Mono", "monospace"] }
    }
  },
  "shadow": {
    "control": { "$type": "shadow", "$value": "none" },
    "panel": { "$type": "shadow", "$value": "none" },
    "raised": {
      "$type": "shadow",
      "$value": "0 1px 0 rgba(255, 255, 255, 0.035)"
    },
    "overlay": {
      "$type": "shadow",
      "$value": "0 24px 70px -42px rgba(0, 0, 0, 0.88), 0 1px 0 rgba(255, 255, 255, 0.05)"
    }
  }
}
