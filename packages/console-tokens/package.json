{
  "name": "@lenso/console-tokens",
  "version": "0.1.1",
  "description": "Generated design tokens for Lenso Console and Module Surfaces.",
  "keywords": [
    "console",
    "design-tokens",
    "lenso",
    "stylex"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "tokens.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/assets/stylex.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.stylex": {
      "types": "./dist/tokens.stylex.d.ts",
      "import": "./dist/tokens.stylex.js",
      "default": "./dist/tokens.stylex.js"
    },
    "./stylex.css": "./dist/assets/stylex.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsdown --config tsdown.config.ts",
    "test": "vitest run --config ../../vite.config.ts src"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "vite": "^8.2.0"
  }
}
