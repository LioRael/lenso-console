{
  "name": "@lenso/console-module-api",
  "version": "1.0.0",
  "description": "Framework-owned contract for dynamically loaded Lenso Console Module UI and Managed Service operations.",
  "keywords": [
    "api",
    "console",
    "lenso",
    "module"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LioRael/lenso-console",
    "directory": "packages/console-module-api"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsdown --config tsdown.config.ts",
    "test": "vitest run src"
  }
}
