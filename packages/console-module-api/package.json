{
  "name": "@lenso/console-module-api",
  "version": "0.1.0",
  "description": "Framework-neutral contract for dynamically loaded Lenso Console Module UI.",
  "keywords": [
    "api",
    "console",
    "lenso",
    "module"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsdown --config tsdown.config.ts",
    "test": "vitest run src"
  }
}
