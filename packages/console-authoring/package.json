{
  "name": "@lenso/console-sdk",
  "version": "0.2.0",
  "description": "Console page authoring: SDK, service client generation, compiler and scaffold",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-console.git",
    "directory": "packages/console-authoring"
  },
  "bin": {
    "lenso-console-author": "./author.mjs"
  },
  "files": [
    "src",
    "compiler/*.mjs",
    "compiler/router.ts",
    "template",
    "service-example",
    "author.mjs",
    "README.md",
    "development-host.md",
    "LICENSE",
    "shell",
    "dev"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contribution": "./src/generated/contribution.ts",
    "./workspace-service": "./src/generated/workspace-service.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./protocol": "./src/protocol.ts",
    "./transport": "./src/transport.ts",
    "./credentials": "./src/credentials.ts",
    "./paths": "./src/paths.ts",
    "./compiler": "./compiler/compiler.mjs",
    "./locale": "./src/locale.ts",
    "./i18n": "./src/i18n.ts",
    "./shell": "./shell/index.html"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module preserve --moduleResolution bundler --skipLibCheck src/*.ts src/generated/*.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@lenso/contract-runtime": "0.3.1",
    "@lenso/tokens": "0.9.1",
    "@lenso/ui": "0.9.1",
    "@orpc/client": "2.0.0-beta.42",
    "@orpc/contract": "2.0.0-beta.42",
    "@streamdown/cjk": "^1.0.3",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-start": "^1.168.38",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "gsap": "^3.15.0",
    "ky": "^2.0.2",
    "lucide-react": "^1.28.0",
    "react-dom": "19.2.8",
    "smol-toml": "^1.8.0",
    "streamdown": "^2.6.0",
    "typescript": "7.0.2",
    "use-sync-external-store": "1.6.0",
    "vite": "^8.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@orpc/server": "2.0.0-beta.42"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.18.0"
  }
}
