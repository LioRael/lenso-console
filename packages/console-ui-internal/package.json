{
  "name": "@lenso/console-ui-internal",
  "version": "0.1.3",
  "private": true,
  "description": "Private compatibility facade for the Console Shell's legacy linked-module imports.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@lenso/console-ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
