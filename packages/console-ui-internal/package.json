{
  "name": "@lenso/console-ui-internal",
  "version": "0.1.3",
  "private": true,
  "description": "Private UI primitives for the Lenso Console Shell and linked Console Modules.",
  "type": "module",
  "sideEffects": [
    "./components.css",
    "./theme.css",
    "./tokens.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components.css": "./components.css",
    "./theme.css": "./theme.css",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
