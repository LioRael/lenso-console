{
  "name": "@lenso/auth-console",
  "version": "0.1.0",
  "description": "Optional capability-driven Auth Console adapter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-console.git",
    "directory": "packages/auth-console"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
