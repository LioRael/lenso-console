{
  "name": "@lenso/console-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "dev": "VITE_CONSOLE_DEV_MODE=${VITE_CONSOLE_DEV_MODE:-mock} VITE_CONSOLE_MODE=${VITE_CONSOLE_MODE:-mock} vite",
    "format": "ultracite fix --unsafe",
    "format:check": "oxfmt --check .",
    "lint": "ultracite check --deny-warnings",
    "check": "ultracite check --deny-warnings && pnpm test && pnpm build:local && pnpm service:check",
    "clean:web": "node scripts/clean-console-web.mjs",
    "bundle:local": "pnpm clean:web && VITE_CONSOLE_MODE=${VITE_CONSOLE_MODE:-api} VITE_API_BASE_URL=${VITE_API_BASE_URL:-/} vite build",
    "service:web-build": "pnpm typecheck:local && VITE_CONSOLE_MODE=api VITE_API_BASE_URL=/ pnpm bundle:local && test -s dist/client/index.html",
    "service:serve": "pnpm service:web-build && cargo run --locked --manifest-path service/Cargo.toml --bin lenso-console",
    "agent:web": "pnpm service:web-build && cargo run --locked --manifest-path service/Cargo.toml --features agent-web --bin lenso-agent-web",
    "service:check": "cargo fmt --manifest-path service/Cargo.toml --all -- --check && cargo clippy --locked --manifest-path service/Cargo.toml --workspace --all-targets --all-features -- -D warnings && cargo test --locked --manifest-path service/Cargo.toml --workspace --all-features",
    "release": "changeset publish",
    "version": "changeset version",
    "build": "pnpm build:local",
    "build:local": "pnpm typecheck:local && pnpm bundle:local",
    "test": "pnpm test:local && pnpm test:browser",
    "test:local": "vitest run src --exclude '**/*.browser.test.*'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "pnpm typecheck:local",
    "typecheck:local": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@lenso/tokens": "0.5.0",
    "@lenso/ui": "0.5.0",
    "@streamdown/cjk": "^1.0.3",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-start": "^1.168.38",
    "@vitejs/plugin-react": "^6.0.5",
    "gsap": "^3.15.0",
    "ky": "^2.0.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "1.62.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.10",
    "typescript": "7.0.2",
    "ultracite": "^7.10.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
