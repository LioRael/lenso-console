{
  "name": "lenso-console-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "dev": "pnpm --dir plugins/console/shell dev",
    "format": "ultracite fix --unsafe",
    "format:check": "oxfmt --check .",
    "lint": "ultracite check --deny-warnings",
    "check": "node tooling/checks/check.mjs",
    "clean:web": "node tooling/distribution/clean-console-web.mjs",
    "contract:typecheck": "pnpm sdk:check",
    "bundle:local": "pnpm --dir plugins/console/shell bundle:local",
    "service:web-build": "pnpm typecheck:local && VITE_CONSOLE_MODE=api VITE_API_BASE_URL=/ pnpm bundle:local && test -s plugins/console/shell/dist/client/index.html",
    "service:serve": "pnpm service:ts:prepare && pnpm service:ts",
    "service:ts": "bun examples/ts-console/serve.ts",
    "service:ts:dev": "bun --conditions=lenso-source examples/ts-console/serve.ts",
    "service:ts:prepare": "pnpm service:check && pnpm service:web-build",
    "service:ts:typecheck": "tsc --noEmit -p examples/ts-console/tsconfig.json",
    "service:ts:check": "pnpm service:ts:typecheck && bun test examples/ts-console",
    "service:boundary": "node --test tooling/distribution/console-ts.test.mjs",
    "service:check": "pnpm --filter @lenso/console build && pnpm --filter @lenso/console typecheck && pnpm --filter @lenso/console test",
    "release": "changeset publish",
    "version": "changeset version",
    "build": "pnpm build:local",
    "build:local": "pnpm typecheck:local && pnpm bundle:local",
    "test": "pnpm test:local && pnpm test:browser",
    "test:local": "pnpm --dir plugins/console/shell test:local",
    "test:browser": "pnpm --dir plugins/console/shell test:browser",
    "typecheck": "pnpm typecheck:local",
    "typecheck:local": "pnpm --dir plugins/console/shell typecheck:local",
    "preview": "pnpm --dir plugins/console/shell preview",
    "test:distribution": "node --test tooling/distribution/sdk-shell.test.mjs tooling/distribution/preview-file-access.test.mjs tooling/distribution/preview-proxy.test.mjs tooling/distribution/wait-for-npm-package.test.mjs",
    "check:preflight": "node tooling/checks/check-environment.mjs && pnpm format:check && pnpm lint && pnpm typecheck:local && pnpm sdk:check && pnpm --filter @lenso/console build && pnpm --filter @lenso/console typecheck",
    "check:full": "pnpm test && pnpm service:check && pnpm test:conventions && pnpm build:local && pnpm service:ts:check && pnpm sdk:stage && pnpm service:boundary && pnpm test:preview && pnpm test:distribution",
    "test:preview": "pnpm sdk:preview && node --test tooling/distribution/sdk-preview.test.mjs",
    "test:conventions": "bun test packages/console-authoring/compiler/test",
    "sdk:check": "pnpm sdk:preview && pnpm --filter @lenso/console-sdk check",
    "framework:prepare": "node tooling/distribution/prepare-ts-framework.mjs",
    "sdk:stage": "node tooling/distribution/prepare-sdk-shell.mjs && pnpm sdk:preview",
    "sdk:prepare": "pnpm service:web-build && pnpm sdk:stage",
    "sdk:preview": "node tooling/distribution/prepare-sdk-preview.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@lenso/auth": "0.3.1",
    "@lenso/authorization": "0.3.0",
    "@lenso/console": "workspace:*",
    "@lenso/console-sdk": "workspace:*",
    "@lenso/contract-runtime": "0.3.1",
    "@lenso/core": "0.3.1",
    "@lenso/engine": "0.5.0",
    "@lenso/manage": "0.4.1",
    "@lenso/web": "0.3.2",
    "@orpc/client": "2.0.0-beta.42",
    "@stylexjs/unplugin": "0.19.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "1.62.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.10",
    "typescript": "7.0.2",
    "ultracite": "^7.10.1",
    "use-sync-external-store": "1.6.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
