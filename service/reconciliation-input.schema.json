{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/schemas/console-reconciliation-input.v1.json",
  "title": "Lenso Console Reconciliation Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recoverySetId",
    "observedAtUnixMs",
    "reviewedBy",
    "authorityEvidenceRef",
    "identityEvidenceRef",
    "outboxEvidenceRef",
    "singleAuthoritativeDeployment",
    "identityAndEnrollmentContinuityVerified",
    "outboxReconciled",
    "managedServices"
  ],
  "properties": {
    "schema": { "const": "lenso.console-reconciliation-input.v1" },
    "recoverySetId": {
      "type": "string",
      "pattern": "^rcv_[a-f0-9-]{36}$"
    },
    "observedAtUnixMs": { "type": "integer", "minimum": 1 },
    "reviewedBy": { "$ref": "#/$defs/evidenceReference" },
    "authorityEvidenceRef": { "$ref": "#/$defs/evidenceReference" },
    "identityEvidenceRef": { "$ref": "#/$defs/evidenceReference" },
    "outboxEvidenceRef": { "$ref": "#/$defs/evidenceReference" },
    "singleAuthoritativeDeployment": { "const": true },
    "identityAndEnrollmentContinuityVerified": { "const": true },
    "outboxReconciled": { "const": true },
    "managedServices": {
      "type": "array",
      "items": { "$ref": "#/$defs/managedService" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidenceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$"
    },
    "managedService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "servicePrincipal",
        "enrollmentReceiptDigest",
        "authorizationEpoch",
        "coreDocumentDigest"
      ],
      "properties": {
        "serviceId": { "type": "string", "minLength": 1 },
        "servicePrincipal": { "type": "string", "minLength": 1 },
        "enrollmentReceiptDigest": { "$ref": "#/$defs/digest" },
        "authorizationEpoch": { "type": "integer", "minimum": 0 },
        "coreDocumentDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    }
  }
}
