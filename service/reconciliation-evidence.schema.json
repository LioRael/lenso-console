{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/schemas/console-reconciliation-evidence.v1.json",
  "title": "Lenso Console Reconciliation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidenceId",
    "evidenceDigest",
    "recoverySetId",
    "recoverySetDigest",
    "restorePlanDigest",
    "reconciliationPlanDigest",
    "releaseId",
    "targetStoreIdentityDigest",
    "storeObservationDigest",
    "reconciliationInputDigest",
    "observedAtUnixMs",
    "reviewedBy",
    "authorityEvidenceRef",
    "identityEvidenceRef",
    "outboxEvidenceRef",
    "singleAuthoritativeDeployment",
    "identityAndEnrollmentContinuityVerified",
    "outboxReconciled",
    "reconciledManagedServices",
    "store"
  ],
  "properties": {
    "schema": { "const": "lenso.console-reconciliation-evidence.v1" },
    "evidenceId": {
      "type": "string",
      "pattern": "^recon_[a-f0-9]{16}$"
    },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "recoverySetId": {
      "type": "string",
      "pattern": "^rcv_[a-f0-9-]{36}$"
    },
    "recoverySetDigest": { "$ref": "#/$defs/digest" },
    "restorePlanDigest": { "$ref": "#/$defs/digest" },
    "reconciliationPlanDigest": { "$ref": "#/$defs/digest" },
    "releaseId": {
      "type": "string",
      "pattern": "^lenso-console@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "targetStoreIdentityDigest": { "$ref": "#/$defs/digest" },
    "storeObservationDigest": { "$ref": "#/$defs/digest" },
    "reconciliationInputDigest": { "$ref": "#/$defs/digest" },
    "activationRecoveryEvidenceDigest": { "$ref": "#/$defs/digest" },
    "observedAtUnixMs": { "type": "integer", "minimum": 1 },
    "reviewedBy": { "$ref": "#/$defs/evidenceReference" },
    "authorityEvidenceRef": { "$ref": "#/$defs/evidenceReference" },
    "identityEvidenceRef": { "$ref": "#/$defs/evidenceReference" },
    "outboxEvidenceRef": { "$ref": "#/$defs/evidenceReference" },
    "singleAuthoritativeDeployment": { "const": true },
    "identityAndEnrollmentContinuityVerified": { "const": true },
    "outboxReconciled": { "const": true },
    "reconciledManagedServices": {
      "type": "array",
      "items": { "$ref": "#/$defs/reconciledManagedService" }
    },
    "store": { "$ref": "#/$defs/storeObservation" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidenceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$"
    },
    "storeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionCount",
        "staleSessionCount",
        "outboxStatusCounts",
        "outboxSnapshotDigest",
        "managedServices"
      ],
      "properties": {
        "sessionCount": { "type": "integer", "minimum": 0 },
        "staleSessionCount": { "const": 0 },
        "outboxStatusCounts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failed": { "type": "integer", "minimum": 1 },
            "pending": { "type": "integer", "minimum": 1 },
            "processing": { "type": "integer", "minimum": 1 },
            "published": { "type": "integer", "minimum": 1 }
          }
        },
        "outboxSnapshotDigest": { "$ref": "#/$defs/digest" },
        "managedServices": {
          "type": "array",
          "items": { "$ref": "#/$defs/managedServiceObservation" }
        }
      }
    },
    "managedServiceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "servicePrincipal",
        "enrollmentReceiptDigest",
        "enrollmentGrantRevision",
        "authorizationEpoch",
        "enrollmentState",
        "version",
        "coreDocumentDigest"
      ],
      "properties": {
        "serviceId": { "type": "string", "minLength": 1 },
        "servicePrincipal": { "type": "string", "minLength": 1 },
        "enrollmentReceiptDigest": { "$ref": "#/$defs/digest" },
        "enrollmentGrantRevision": { "type": "integer", "minimum": 1 },
        "authorizationEpoch": { "type": "integer", "minimum": 0 },
        "enrollmentState": { "enum": ["active", "revoked"] },
        "version": { "type": "integer", "minimum": 1 },
        "coreDocumentDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    },
    "reconciledManagedService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "servicePrincipal",
        "enrollmentReceiptDigest",
        "authorizationEpoch",
        "coreDocumentDigest"
      ],
      "properties": {
        "serviceId": { "type": "string", "minLength": 1 },
        "servicePrincipal": { "type": "string", "minLength": 1 },
        "enrollmentReceiptDigest": { "$ref": "#/$defs/digest" },
        "authorizationEpoch": { "type": "integer", "minimum": 0 },
        "coreDocumentDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    }
  }
}
