{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/schemas/console-activation-evidence.v1.json",
  "title": "Lenso Console Activation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidenceId",
    "evidenceDigest",
    "recoverySetId",
    "recoverySetDigest",
    "restorePlanDigest",
    "reconciliationPlanDigest",
    "reconciliationEvidenceDigest",
    "activationPlanDigest",
    "releaseId",
    "targetStoreIdentityDigest",
    "authorityTransferApproved",
    "workloadMode",
    "authorityProbe",
    "authorityProbeDigest",
    "activatedAtUnixMs"
  ],
  "properties": {
    "schema": { "const": "lenso.console-activation-evidence.v1" },
    "evidenceId": {
      "type": "string",
      "pattern": "^act_[a-f0-9]{16}$"
    },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "recoverySetId": {
      "type": "string",
      "pattern": "^rcv_[a-f0-9-]{36}$"
    },
    "recoverySetDigest": { "$ref": "#/$defs/digest" },
    "restorePlanDigest": { "$ref": "#/$defs/digest" },
    "reconciliationPlanDigest": { "$ref": "#/$defs/digest" },
    "reconciliationEvidenceDigest": { "$ref": "#/$defs/digest" },
    "activationPlanDigest": { "$ref": "#/$defs/digest" },
    "releaseId": {
      "type": "string",
      "pattern": "^lenso-console@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "targetStoreIdentityDigest": { "$ref": "#/$defs/digest" },
    "authorityTransferApproved": { "const": true },
    "workloadMode": { "const": "normal" },
    "authorityProbe": { "$ref": "#/$defs/authorityProbe" },
    "authorityProbeDigest": { "$ref": "#/$defs/digest" },
    "activatedAtUnixMs": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "authorityProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "serviceId", "workloadMode"],
      "properties": {
        "schema": { "const": "lenso.console-authority.v1" },
        "serviceId": { "const": "lenso-console" },
        "workloadMode": { "const": "normal" }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
