{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["logs", "next_cursor"],
  "properties": {
    "logs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "timestamp_unix_nano",
          "span_id",
          "severity",
          "body",
          "attributes"
        ],
        "properties": {
          "timestamp_unix_nano": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "span_id": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{16}$"
          },
          "severity": { "type": "string", "maxLength": 32 },
          "body": { "type": "string", "maxLength": 16384 },
          "attributes": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "properties": {
                "key": { "type": "string", "maxLength": 256 },
                "value": { "type": "string", "maxLength": 4096 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "next_cursor": { "type": ["string", "null"], "maxLength": 256 }
  },
  "additionalProperties": false
}
