{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source_id", "trace_id"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
  },
  "additionalProperties": false
}
