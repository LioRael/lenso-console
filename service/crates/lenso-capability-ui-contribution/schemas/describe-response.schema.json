{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workspace_id",
    "title",
    "revision",
    "module",
    "styles",
    "navigation",
    "assets",
    "requirements"
  ],
  "properties": {
    "workspace_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "subject": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["console", "app"] },
        "app_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "module": { "type": "string", "minLength": 1, "maxLength": 256 },
    "styles": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "navigation": {
      "type": "object",
      "required": ["label", "items"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["label", "path"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "path": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["path", "media_type", "content_base64"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "media_type": {
            "type": "string",
            "enum": [
              "text/css; charset=utf-8",
              "text/javascript; charset=utf-8"
            ]
          },
          "content_base64": { "type": "string", "maxLength": 1398104 }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["capability_id", "descriptor_version", "operations"],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "descriptor_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
