{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/schemas/console-service-release.v1.json",
  "title": "Lenso Console Service Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "version",
    "sourceCommit",
    "image",
    "compositionDigest",
    "schemaDigest",
    "contractDigest",
    "configurationDigest",
    "compatibleFromSchemaDigests",
    "irreversibleMigrations"
  ],
  "properties": {
    "schema": { "const": "lenso.console-service-release.v1" },
    "releaseId": {
      "type": "string",
      "pattern": "^lenso-console@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "@sha256:[a-f0-9]{64}$"
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "compositionDigest": { "$ref": "#/$defs/digest" },
    "schemaDigest": { "$ref": "#/$defs/digest" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "configurationDigest": { "$ref": "#/$defs/digest" },
    "compatibleFromSchemaDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "irreversibleMigrations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
