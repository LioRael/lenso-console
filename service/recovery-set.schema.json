{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/schemas/console-recovery-set.v1.json",
  "title": "Lenso Console Recovery Set Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recoverySetId",
    "recoverySetDigest",
    "createdAtUnixMs",
    "releaseId",
    "releaseDigest",
    "imageReference",
    "schemaDigest",
    "compositionDigest",
    "contractDigest",
    "configurationDigest",
    "store",
    "secretReferences",
    "restorePreconditions"
  ],
  "properties": {
    "schema": { "const": "lenso.console-recovery-set.v1" },
    "recoverySetId": {
      "type": "string",
      "pattern": "^rcv_[a-f0-9-]{36}$"
    },
    "recoverySetDigest": { "$ref": "#/$defs/digest" },
    "createdAtUnixMs": { "type": "integer", "minimum": 1 },
    "releaseId": {
      "type": "string",
      "pattern": "^lenso-console@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "releaseDigest": { "$ref": "#/$defs/digest" },
    "imageReference": {
      "type": "string",
      "pattern": "^ghcr\\.io/liorael/lenso-console@sha256:[a-f0-9]{64}$"
    },
    "schemaDigest": { "$ref": "#/$defs/digest" },
    "compositionDigest": { "$ref": "#/$defs/digest" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "configurationDigest": { "$ref": "#/$defs/digest" },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "encrypted",
        "encryption",
        "payload",
        "payloadDigest",
        "recipient",
        "excludedData"
      ],
      "properties": {
        "format": { "const": "postgresql-custom" },
        "encrypted": { "const": true },
        "encryption": { "const": "age-v1" },
        "payload": { "const": "store.dump.age" },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "recipient": { "type": "string", "minLength": 1 },
        "excludedData": { "const": ["auth.sessions"] }
      }
    },
    "secretReferences": {
      "const": ["CONSOLE_DATABASE_URL"]
    },
    "restorePreconditions": {
      "const": [
        "clean_store",
        "exact_release_and_composition",
        "external_secret_resolution",
        "outbound_mutations_disabled",
        "single_authoritative_deployment",
        "identity_and_enrollment_continuity_validation"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
