APP_ENV=local
SERVICE_NAME=lenso-console
LENSO_COMPOSITION_PROFILE=core
LENSO_MODULE_PLATFORM_STORY_ENABLED=false
DATABASE_URL=postgres://lenso_console:lenso_console@localhost:55433/lenso_console
CONSOLE_RECOVERY_MODE=normal
# Set only for an explicitly fenced local recovery request, then remove it.
# CONSOLE_BOOTSTRAP_RECOVERY_TOKEN=
DATABASE_MAX_CONNECTIONS=10
HTTP_HOST=127.0.0.1
HTTP_PORT=3030
CORS_ALLOWED_ORIGINS=http://localhost:3030
RUST_LOG=info,lenso_console_service=debug
LOG_FORMAT=compact
# Optional Console-owned content-addressed artifact store.
# CONSOLE_ARTIFACT_ROOT=service/artifacts
# Server-only local Workload Control Adapter directory. Targets must be path-free
# origins on exactly 127.0.0.1 or localhost; never expose this value to a browser.
# LENSO_CONSOLE_WORKLOAD_CONTROL_ADAPTERS='[{"systemId":"support-desk","adapterId":"support-control","baseUrl":"http://127.0.0.1:9470","bearerToken":"replace-with-a-local-adapter-token"}]'
# Server-only bridge to one local Lenso Agent Harness control surface.
# LENSO_CONSOLE_AGENT_CONTROL_URL=http://127.0.0.1:8788
# LENSO_CONSOLE_AGENT_CONTROL_TOKEN=replace-with-the-harness-control-token
# Server-only, local System enrollment trust. Every Service key is pinned to one
# System identity, Service principal, loopback origin, and target-specific Core
# token. Never expose this JSON or its token to the browser.
# LENSO_MODULE_LENSO_SYSTEM_REGISTRY__ENROLLMENT_TRUST='{"consoleAuthorityKeys":[{"keyId":"console-local-1","publicKeyBase64url":"replace-with-32-byte-ed25519-public-key-base64url","consoleServicePrincipal":"service:lenso-console"}],"managedServiceKeys":[{"keyId":"support-local-1","publicKeyBase64url":"replace-with-32-byte-ed25519-public-key-base64url","systemId":"support-desk","managedServiceId":"support-service","managedServicePrincipal":"svc.support-service","baseUrl":"http://127.0.0.1:4110/lenso/service/v1","systemPlaneBearerToken":"replace-with-a-target-specific-local-token"}]}'
