HTTP_HOST=127.0.0.1
HTTP_PORT=3030
# Defaults to ~/.lenso/console and stores only private Console Agent state.
# LENSO_CONSOLE_HOME=/absolute/path/to/console-home
# The Host stores durable Console Agent configuration authority state at
# <LENSO_CONSOLE_HOME>/agent-configuration.sqlite3.
# App managed by Console. Relative paths resolve from the launch directory;
# the default is the launch directory itself.
# LENSO_APP_ROOT=/absolute/path/to/lenso-app
# Unset admits the five reviewed Plugin management Tools. Set an exact,
# comma-separated subset to narrow access, or set an empty value to disable all.
# LENSO_CONSOLE_AGENT_TOOLS=
# Optional App Agent identity shown alongside the private Console Agent. The
# Adapter accepts only a clean loopback HTTP origin.
# LENSO_CONSOLE_CONNECTED_AGENT_URL=http://127.0.0.1:8787
# LENSO_CONSOLE_CONNECTED_AGENT_LABEL=Lenso Agent
# Enable only when that App Agent Host provides Host-authorized durable Plugin
# configuration control. Catalog membership alone never grants this capability.
# LENSO_CONSOLE_CONNECTED_AGENT_PLUGIN_CONFIGURATION=true
# Authority selected by the App Agent Host started through `pnpm agent:web`.
# Defaults to sqlite_configuration_store. Supported concrete selections:
# local_plugin_root, sqlite_configuration_store, remote_configuration_service.
# LENSO_AGENT_PLUGIN_CONFIGURATION_AUTHORITY=sqlite_configuration_store
# Optional absolute SQLite database path. Defaults inside LENSO_AGENT_HOME.
# LENSO_AGENT_PLUGIN_CONFIGURATION_STORE=/absolute/path/plugin-configuration.sqlite3
# Remote selection requires every coordinate and keeps its token in the App
# Agent Host rather than exposing it to Console.
# LENSO_AGENT_PLUGIN_CONFIGURATION_REMOTE_URL=https://configuration.example.com
# LENSO_AGENT_PLUGIN_CONFIGURATION_REMOTE_APP=my-agent
# LENSO_AGENT_PLUGIN_CONFIGURATION_REMOTE_ENVIRONMENT=production
# LENSO_PLUGIN_CONFIGURATION_REMOTE_TOKEN=replace-me
# Optional prebuilt Shell directory. Source builds default to ../dist/client.
# CONSOLE_WEB_ROOT=/absolute/path/to/dist/client
